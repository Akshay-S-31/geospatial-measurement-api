# Copy to .env and adjust. Every value shown is the default.

# SQLAlchemy URL of the metadata and results database.
DATABASE_URL=sqlite:///./data/app.db

# Directory for raw uploads and temporary extraction folders.
STORAGE_DIR=./data/uploads

# Largest accepted upload, in megabytes. Larger uploads get 413.
MAX_UPLOAD_MB=50

# Largest total uncompressed size of a zip archive, in megabytes (zip-bomb guard).
MAX_UNZIPPED_MB=500

# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO

# Longest edge, in degrees, left undensified before projecting geographic geometries.
DENSIFY_MAX_SEGMENT_DEG=0.01
